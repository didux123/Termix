{
  "name": "termix-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol (MCP) server for Termix — exposes the Termix HTTP API to MCP clients such as Claude Code and Claude Desktop.",
  "bin": {
    "termix-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
